# Local PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://iword:iword@localhost:5432/iword

# Neon: use the pooled connection string shown in the Neon dashboard instead.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Workspace for CLI seeding, batch audio and first teacher bootstrap only.
# This value NEVER bypasses login or grants web request permissions.
DEV_USER_ID=local-preview-teacher

# Public application origin (no secret).
APP_ORIGIN=http://localhost:3000

# Web playback uses authenticated /api/pronunciation and private COS signed URLs.
# NEXT_PUBLIC_PRONUNCIATION_MANIFEST_URL is no longer needed.

# Server-side only: on-demand and batch pronunciation generation + COS upload.
# Create a least-privilege Tencent Cloud CAM identity; never prefix secrets with NEXT_PUBLIC_.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-chongqing
TENCENT_COS_PREFIX=pronunciations/v1
TENCENT_TTS_VOICE_TYPE=403006
TENCENT_TTS_SAMPLE_RATE=24000
TENCENT_TTS_SPEED=0

# Keep a local copy under public/ for local development. Set to false after the
# production CDN manifest URL is configured and the audio library becomes large.
PRONUNCIATION_WRITE_LOCAL=true

# Use "database" after Neon/PostgreSQL is connected; keep "seed" for the current demo list.
PRONUNCIATION_WORD_SOURCE=seed
